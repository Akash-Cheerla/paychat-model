# conv_model/conv_model.onnx is TRACKED as of 2026-09-07 - it is now the runtime
# artifact, not an intermediate.
#
# It used to be ignored because "nothing loads it at runtime and it is 474MB", which was
# true while conv_model_int8.onnx was what shipped. On v14 the quantisation stopped being
# free: replaying 2,280 real dogfood messages through int8 and through the plain weights
# gave 132 prompts against 138, and the eight int8 dropped included the offer-confirmation
# fix the retrain was built for, while it ADDED a fire on the unprompted offer itself.
# fp32 ONNX matches the weights exactly - 17/17 batteries and all 2,280 messages - at
# 100ms median against int8's 62ms. conv_classifier.py loads int8 first, then this.
#
# Re-quantising with proper calibration is a v15 task; if that lands and verifies against
# a real-traffic replay (not just the batteries - they scored int8 HIGHER while it was
# inverting the fix), the int8 comes back and this can be ignored again.

# Training data stays on disk, not in git — conversations_v5.json never was tracked
# and conversations_v6 is 51MB. The generators in data_gen/ are the reproducible part.
data/conversations/

# Personal WhatsApp exports - third-party messages, never committed
data/private_wa/

# Trained models and training archives — hundreds of MB each, rebuilt by the notebook.
conv_model_v*/
saved_model_v*/
conv_model_prev*/
conv_model_v*_local/
*.zip

# Dogfood logs are real user messages from the team's own chats. They stay on disk.
data/eval/dogfood_*.jsonl
data/eval/sender_missing_evidence.jsonl
data/private_wa/

# Teacher-labelled REAL conversations. Derived from dogfood logs and WhatsApp
# exports, so they carry the same restriction as their sources: measurement only,
# never committed, never pasted into training data verbatim.
data/eval/real_*.json
data/eval/REAL_*.json
data/eval/REAL_*.md
data/eval/labelled_real*.json

# The DEFAULT log path. Running with PAYCHAT_LOG_ALL and no PAYCHAT_LOG_PATH
# drops real conversations here, one JSON line per message. Never commit it.
dogfood.jsonl
*.jsonl
!data/conversations/*.jsonl

# Research and labelling tooling
# Sweeps, LLM labelling, WhatsApp study and the exploratory runners. Kept locally,
# not shared: they are working notes, and several are experiments that went nowhere.
# The regression suite is deliberately NOT here - tests/ stays in git so anyone can
# reproduce a reported number, and tests/run_preflight.sh is the entry point.
tools/

# Generated training sets
# Built by data_gen/build_base_v26*.py and gated by gate_base_v26.py. train_v26.json
# alone is 57MB, and training data has never belonged in this repo. The scripts that
# build it are reproducible from the specs; the output is not worth versioning.
data_gen/base_v26/
data_gen/conv_v12/

# Colab upload bundle for conv v12
# 447MB of warm-start weights and 9.5MB of training windows. Reproducible from
# data_gen/build_conv_v12.py and conv_model/; not worth versioning.
colab_conv_v12/
conv_windows_v12.zip
